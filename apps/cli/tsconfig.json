{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "../..",
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@openharness/coordinator": [
        "../../packages/coordinator/src/index.ts"
      ],
      "@openharness/core": [
        "../../packages/core/src/index.ts"
      ],
      "@openharness/memory": [
        "../../packages/memory/src/index.ts"
      ],
      "@openharness/server": [
        "../../packages/server/src/index.ts"
      ],
      "@openharness/services": [
        "../../packages/services/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "build.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
