{
  "name": "@openharness/services",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./memory-extract": {
      "import": "./src/memory-extract.ts",
      "types": "./src/memory-extract.ts"
    },
    "./session-runtime/types": {
      "import": "./src/session-runtime/types.ts",
      "types": "./src/session-runtime/types.ts"
    }
  },
  "scripts": {
    "build": "exit 0",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@openharness/core": "workspace:*",
    "@openharness/memory": "workspace:*",
    "@openharness/sandbox": "workspace:*",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.3",
    "vitest": "catalog:"
  }
}
