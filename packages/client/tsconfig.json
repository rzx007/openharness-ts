{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "../..",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@openharness/core": [
        "../core/src/index.ts"
      ],
      "@openharness/memory": [
        "../memory/src/index.ts"
